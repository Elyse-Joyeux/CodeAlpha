# Copy this file to ".env" and fill in your values.

# MongoDB connection string.
# Local MongoDB (install MongoDB Community Edition and run `mongod`):
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# Or use MongoDB Atlas (free cloud cluster) - get a connection string from
# https://www.mongodb.com/cloud/atlas and replace <user>:<password>:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ecommerce

# Secret used to sign login tokens (change this to any random string)
JWT_SECRET=change_this_to_a_long_random_secret_string

# Port the server listens on
PORT=5000
