{
  "name": "meetspace",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
